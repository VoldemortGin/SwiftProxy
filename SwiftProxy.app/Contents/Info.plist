<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle Identifier -->
    <key>CFBundleIdentifier</key>
    <string>com.swiftproxy.app</string>

    <!-- Bundle Name -->
    <key>CFBundleName</key>
    <string>SwiftProxy</string>

    <!-- Bundle Display Name -->
    <key>CFBundleDisplayName</key>
    <string>SwiftProxy</string>

    <!-- Bundle Version -->
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <!-- Bundle Build Version -->
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Executable Name -->
    <key>CFBundleExecutable</key>
    <string>SwiftProxy</string>

    <!-- Package Type -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Signature -->
    <key>CFBundleSignature</key>
    <string>????</string>

    <!-- Info Dictionary Version -->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- Minimum System Version -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- UI is Agent -->
    <key>LSUIElement</key>
    <false/>

    <!-- Background Only -->
    <key>LSBackgroundOnly</key>
    <false/>

    <!-- Supports Automatic Termination -->
    <key>NSSupportsAutomaticTermination</key>
    <true/>

    <!-- Supports Sudden Termination -->
    <key>NSSupportsSuddenTermination</key>
    <false/>

    <!-- High Resolution Capable -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Principal Class -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Human Readable Copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>© 2024 SwiftProxy. All rights reserved.</string>

    <!-- Network Permissions -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>SwiftProxy needs access to the local network to function as a proxy server.</string>

    <!-- Network Client -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Network Server -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow Arbitrary Loads (for development) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Main SwiftUI App -->
    <key>NSMainSwiftUIApplicationClass</key>
    <string>SwiftProxyApp</string>
</dict>
</plist>
