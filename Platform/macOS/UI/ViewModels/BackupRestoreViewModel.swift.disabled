import Foundation
import OSLog

/// ViewModel for backup and restore functionality
@MainActor
public class BackupRestoreViewModel: ObservableObject {
    // MARK: - Properties

    @Published public var backups: [Backup] = []
    @Published public var statistics: BackupStatistics?
    @Published public var isLoading = false
    @Published public var errorMessage: String?
    @Published public var autoBackupEnabled = false

    private let backupService: BackupService
    private let configurationService: ConfigurationService
    private let ruleService: RuleServiceProtocol
    private let logger: OSLog

    // MARK: - Initialization

    public init(
        backupService: BackupService,
        configurationService: ConfigurationService,
        ruleService: RuleServiceProtocol,
        logger: OSLog? = nil
    ) {
        self.backupService = backupService
        self.configurationService = configurationService
        self.ruleService = ruleService
        self.logger = logger ?? OSLog(subsystem: "com.swiftproxy.app", category: "backup-vm")
    }

    // MARK: - Load Backups

    public func loadBackups() async {
        isLoading = true
        errorMessage = nil

        do {
            backups = try await backupService.listBackups()
            statistics = try await backupService.getBackupStatistics()

            os_log(.info, log: logger, "Loaded \(self.backups.count) backups")
        } catch {
            os_log(.error, log: logger, "Failed to load backups: \(error.localizedDescription)")
            errorMessage = error.localizedDescription
        }

        isLoading = false
    }

    // MARK: - Create Backup

    public func createManualBackup() async {
        isLoading = true
        errorMessage = nil

        do {
            // Get current configurations and rules
            let configurations = await configurationService.getAllConfigurations()
            let rules = await ruleService.getAllRules()

            // Create backup
            let backup = try await backupService.createBackup(
                configurations: configurations,
                rules: rules
            )

            os_log(.info, log: logger, "Manual backup created: \(backup.id)")

            // Announce to VoiceOver
            await AccessibilityAnnouncer.shared.announce("Backup created successfully")

            // Reload backups
            await loadBackups()
        } catch {
            os_log(.error, log: logger, "Failed to create backup: \(error.localizedDescription)")
            errorMessage = error.localizedDescription
        }

        isLoading = false
    }

    // MARK: - Restore Backup

    public func restoreBackup(_ backup: Backup) async {
        isLoading = true
        errorMessage = nil

        do {
            // Restore configurations and rules
            let (configurations, rules) = try await backupService.restoreBackup(backup)

            // Save configurations
            for configuration in configurations {
                await configurationService.saveConfiguration(configuration)
            }

            // Save rules
            for rule in rules {
                try await ruleService.addRule(rule)
            }

            os_log(.info, log: logger, "Backup restored: \(backup.id)")

            // Announce to VoiceOver
            await AccessibilityAnnouncer.shared.announce("Backup restored successfully")
        } catch {
            os_log(.error, log: logger, "Failed to restore backup: \(error.localizedDescription)")
            errorMessage = error.localizedDescription
        }

        isLoading = false
    }

    // MARK: - Delete Backup

    public func deleteBackup(_ backup: Backup) async {
        isLoading = true
        errorMessage = nil

        do {
            try await backupService.deleteBackup(backup.id)

            os_log(.info, log: logger, "Backup deleted: \(backup.id)")

            // Announce to VoiceOver
            await AccessibilityAnnouncer.shared.announce("Backup deleted")

            // Reload backups
            await loadBackups()
        } catch {
            os_log(.error, log: logger, "Failed to delete backup: \(error.localizedDescription)")
            errorMessage = error.localizedDescription
        }

        isLoading = false
    }

    // MARK: - Import Backup

    public func importBackup(from url: URL) async {
        isLoading = true
        errorMessage = nil

        do {
            let (configurations, rules) = try await backupService.restoreFromFile(url: url)

            // Save configurations
            for configuration in configurations {
                await configurationService.saveConfiguration(configuration)
            }

            // Save rules
            for rule in rules {
                try await ruleService.addRule(rule)
            }

            os_log(.info, log: logger, "Backup imported from file: \(url.path)")

            // Announce to VoiceOver
            await AccessibilityAnnouncer.shared.announce("Backup imported successfully")

            // Reload backups
            await loadBackups()
        } catch {
            os_log(.error, log: logger, "Failed to import backup: \(error.localizedDescription)")
            errorMessage = error.localizedDescription
        }

        isLoading = false
    }

    // MARK: - Error Handling

    public func showError(_ message: String) {
        errorMessage = message
    }

    public func clearError() {
        errorMessage = nil
    }
}

// MARK: - Preview

#if DEBUG
extension BackupRestoreViewModel {
    static var preview: BackupRestoreViewModel {
        let vm = BackupRestoreViewModel(
            backupService: BackupService(),
            configurationService: ConfigurationService(),
            ruleService: MockRuleService()
        )

        // Add sample backups
        vm.backups = [
            Backup(
                id: UUID(),
                name: "Manual Backup - Jan 26",
                timestamp: Date(),
                type: .manual,
                configurations: [],
                rules: []
            ),
            Backup(
                id: UUID(),
                name: "Auto Backup - Jan 25",
                timestamp: Date().addingTimeInterval(-86400),
                type: .automatic,
                configurations: [],
                rules: []
            ),
            Backup(
                id: UUID(),
                name: "Manual Backup - Jan 24",
                timestamp: Date().addingTimeInterval(-172800),
                type: .manual,
                configurations: [],
                rules: []
            )
        ]

        vm.statistics = BackupStatistics(
            totalBackups: 3,
            manualBackups: 2,
            automaticBackups: 1,
            totalSize: 1024 * 1024 * 5, // 5 MB
            lastBackupDate: Date()
        )

        return vm
    }
}
#endif
