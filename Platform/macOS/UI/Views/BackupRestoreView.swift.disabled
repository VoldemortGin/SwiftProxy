import SwiftUI
import SwiftProxyCore

/// View for managing backups and restores
struct BackupRestoreView: View {
    // MARK: - Properties

    @StateObject private var viewModel: BackupRestoreViewModel
    @State private var showingFileImporter = false
    @State private var showingFileExporter = false
    @State private var selectedBackup: Backup?
    @State private var showingDeleteConfirmation = false

    init(viewModel: BackupRestoreViewModel) {
        _viewModel = StateObject(wrappedValue: viewModel)
    }

    // MARK: - Body

    var body: some View {
        VStack(spacing: 0) {
            // Header
            headerView

            Divider()

            // Content
            if viewModel.isLoading {
                loadingView
            } else if viewModel.backups.isEmpty {
                emptyStateView
            } else {
                backupListView
            }

            Divider()

            // Footer with statistics
            footerView
        }
        .onAppear {
            Task {
                await viewModel.loadBackups()
            }
        }
        .fileImporter(
            isPresented: $showingFileImporter,
            allowedContentTypes: [.json],
            allowsMultipleSelection: false
        ) { result in
            handleFileImport(result)
        }
        .fileExporter(
            isPresented: $showingFileExporter,
            document: selectedBackup.map { BackupDocument(backup: $0) },
            contentType: .json,
            defaultFilename: selectedBackup?.name ?? "Backup"
        ) { result in
            handleFileExport(result)
        }
        .alert("Delete Backup", isPresented: $showingDeleteConfirmation) {
            Button("Cancel", role: .cancel) {}
            Button("Delete", role: .destructive) {
                if let backup = selectedBackup {
                    Task {
                        await viewModel.deleteBackup(backup)
                    }
                }
            }
        } message: {
            Text("Are you sure you want to delete this backup? This action cannot be undone.")
        }
        .alert("Error", isPresented: .constant(viewModel.errorMessage != nil)) {
            Button("OK") {
                viewModel.clearError()
            }
        } message: {
            if let error = viewModel.errorMessage {
                Text(error)
            }
        }
    }

    // MARK: - Subviews

    private var headerView: some View {
        HStack {
            VStack(alignment: .leading, spacing: 4) {
                Text(L10n.backupTitle)
                    .font(AppTheme.Typography.title2)
                    .accessibleHeading(label: L10n.backupTitle)

                Text("\(viewModel.backups.count) backups")
                    .font(AppTheme.Typography.caption)
                    .foregroundColor(AppTheme.Colors.secondaryText)
            }

            Spacer()

            HStack(spacing: 12) {
                Button(action: {
                    Task {
                        await viewModel.createManualBackup()
                    }
                }) {
                    Label(L10n.backupCreate, systemImage: "plus.circle.fill")
                }
                .primaryButtonStyle()
                .accessibleButton(label: "Create new backup")

                Button(action: {
                    showingFileImporter = true
                }) {
                    Label("Import", systemImage: "square.and.arrow.down")
                }
                .secondaryButtonStyle()
                .accessibleButton(label: "Import backup from file")

                Button(action: {
                    Task {
                        await viewModel.loadBackups()
                    }
                }) {
                    Image(systemName: "arrow.clockwise")
                }
                .accessibleButton(label: "Refresh backup list")
            }
        }
        .padding()
    }

    private var loadingView: some View {
        VStack(spacing: 16) {
            ProgressView()
                .scaleEffect(1.5)

            Text("Loading backups...")
                .font(AppTheme.Typography.subheadline)
                .foregroundColor(AppTheme.Colors.secondaryText)
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity)
    }

    private var emptyStateView: some View {
        VStack(spacing: 20) {
            Image(systemName: "archivebox")
                .font(.system(size: 64))
                .foregroundColor(AppTheme.Colors.secondary)

            Text("No Backups Yet")
                .font(AppTheme.Typography.title3)

            Text("Create your first backup to protect your configurations and rules")
                .font(AppTheme.Typography.body)
                .foregroundColor(AppTheme.Colors.secondaryText)
                .multilineTextAlignment(.center)
                .frame(maxWidth: 400)

            Button(action: {
                Task {
                    await viewModel.createManualBackup()
                }
            }) {
                Label(L10n.backupCreate, systemImage: "plus.circle.fill")
            }
            .primaryButtonStyle()
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity)
        .padding()
    }

    private var backupListView: some View {
        ScrollView {
            LazyVStack(spacing: 12) {
                ForEach(viewModel.backups) { backup in
                    BackupRow(backup: backup)
                        .contextMenu {
                            Button(action: {
                                Task {
                                    await viewModel.restoreBackup(backup)
                                }
                            }) {
                                Label(L10n.backupRestore, systemImage: "arrow.counterclockwise")
                            }

                            Button(action: {
                                selectedBackup = backup
                                showingFileExporter = true
                            }) {
                                Label("Export", systemImage: "square.and.arrow.up")
                            }

                            Divider()

                            Button(role: .destructive, action: {
                                selectedBackup = backup
                                showingDeleteConfirmation = true
                            }) {
                                Label(L10n.backupDelete, systemImage: "trash")
                            }
                        }
                        .onTapGesture {
                            selectedBackup = backup
                        }
                        .accessibilityIdentifier("backup_\(backup.id)")
                        .animatedAppear(delay: Double(viewModel.backups.firstIndex(where: { $0.id == backup.id }) ?? 0) * 0.05)
                }
            }
            .padding()
        }
    }

    private var footerView: some View {
        HStack {
            if let stats = viewModel.statistics {
                HStack(spacing: 24) {
                    StatItem(label: "Total", value: "\(stats.totalBackups)")
                    StatItem(label: "Size", value: stats.formattedSize)
                    StatItem(label: "Last Backup", value: stats.formattedLastBackup)
                }
                .font(AppTheme.Typography.caption)
                .foregroundColor(AppTheme.Colors.secondaryText)
            }

            Spacer()

            Toggle("Auto Backup", isOn: $viewModel.autoBackupEnabled)
                .accessibleToggle(label: "Automatic backup", isOn: viewModel.autoBackupEnabled)
        }
        .padding()
    }

    // MARK: - Methods

    private func handleFileImport(_ result: Result<[URL], Error>) {
        switch result {
        case .success(let urls):
            guard let url = urls.first else { return }
            Task {
                await viewModel.importBackup(from: url)
            }
        case .failure(let error):
            viewModel.showError(error.localizedDescription)
        }
    }

    private func handleFileExport(_ result: Result<URL, Error>) {
        switch result {
        case .success:
            Task {
                await AccessibilityAnnouncer.shared.announce("Backup exported successfully")
            }
        case .failure(let error):
            viewModel.showError(error.localizedDescription)
        }
    }
}

// MARK: - Backup Row

private struct BackupRow: View {
    let backup: Backup

    var body: some View {
        HStack(spacing: 16) {
            // Icon
            Image(systemName: backup.type == .manual ? "archivebox.fill" : "clock.arrow.circlepath")
                .font(.title2)
                .foregroundColor(backup.type == .manual ? AppTheme.Colors.primary : AppTheme.Colors.secondary)
                .frame(width: 40)

            // Info
            VStack(alignment: .leading, spacing: 4) {
                Text(backup.name)
                    .font(AppTheme.Typography.headline)

                HStack(spacing: 12) {
                    Label("\(backup.configurations.count) configs", systemImage: "network")
                    Label("\(backup.rules.count) rules", systemImage: "list.bullet")
                }
                .font(AppTheme.Typography.caption)
                .foregroundColor(AppTheme.Colors.secondaryText)
            }

            Spacer()

            // Date
            VStack(alignment: .trailing, spacing: 4) {
                Text(backup.formattedDate)
                    .font(AppTheme.Typography.caption)
                    .foregroundColor(AppTheme.Colors.secondaryText)

                Text(backup.type.rawValue.capitalized)
                    .font(AppTheme.Typography.caption2)
                    .padding(.horizontal, 8)
                    .padding(.vertical, 2)
                    .background(backup.type == .manual ? AppTheme.Colors.primary.opacity(0.2) : AppTheme.Colors.secondary.opacity(0.2))
                    .cornerRadius(4)
            }
        }
        .padding()
        .cardStyle()
        .accessible(
            label: "\(backup.name), \(backup.type.rawValue) backup",
            hint: "Created on \(backup.formattedDate). Contains \(backup.configurations.count) configurations and \(backup.rules.count) rules"
        )
    }
}

// MARK: - Stat Item

private struct StatItem: View {
    let label: String
    let value: String

    var body: some View {
        HStack(spacing: 4) {
            Text(label + ":")
            Text(value)
                .fontWeight(.semibold)
        }
    }
}

// MARK: - Backup Document

private struct BackupDocument: FileDocument {
    static var readableContentTypes: [UTType] { [.json] }

    let backup: Backup

    init(backup: Backup) {
        self.backup = backup
    }

    init(configuration: ReadConfiguration) throws {
        throw CocoaError(.fileReadCorruptFile)
    }

    func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper {
        let encoder = JSONEncoder()
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        encoder.dateEncodingStrategy = .iso8601

        let data = try encoder.encode(backup)
        return FileWrapper(regularFileWithContents: data)
    }
}

// MARK: - Preview

#Preview("Backup & Restore") {
    BackupRestoreView(viewModel: BackupRestoreViewModel.preview)
        .frame(width: 700, height: 500)
}

#Preview("Dark Mode") {
    BackupRestoreView(viewModel: BackupRestoreViewModel.preview)
        .frame(width: 700, height: 500)
        .preferredColorScheme(.dark)
}
